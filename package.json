{
  "name": "erics-designs-erp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Local MongoDB API for Eric's Designs Mini CRM",
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "check": "node --check server/server.js",
    "mobile:sync": "npx cap sync ios",
    "mobile:ios": "npx cap open ios",
    "mobile:check": "node --check crm.js && node --check api-sync.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
